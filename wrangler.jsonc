{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blueseatstudios",
  "compatibility_date": "2025-09-27",
  "main": "./worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ta-demo", "/ta-demo/*"]
  },
  // TA demo dashboard log. Create with: npx wrangler kv namespace create DEMO_LOG, then paste the id
  // "kv_namespaces": [{ "binding": "DEMO_LOG", "id": "PASTE_ID" }],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
